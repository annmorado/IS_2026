# COPIAR DE NEON: usa la conexion DIRECTA, no la del pooler.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require"
# Bootstrap temporal: habilitar SOLO en tu PC, nunca en la nube.
NEXO_ENVIRONMENT=production
NEXO_BOOTSTRAP_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO
# RF-002: generar un secreto diferente por entorno usando scripts.setup_auth_env
NEXO_JWT_SECRET=GENERAR_AUTOMATICAMENTE_EN_ENTORNO_LOCAL

# RF-029 (opcional): Tesseract OCR instalado en Windows para leer fotos.
# NEXO_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# RF-030 (opcional): UNA organización con cuenta oficial de Meta WhatsApp Cloud.
# Sin los cuatro valores la API jamás enviará mensajes. No son necesarios para las pruebas.
# NEXO_WHATSAPP_ORG_ID=UUID_DE_TU_EMPRESA
# NEXO_WHATSAPP_PHONE_ID=ID_OFICIAL_NUMERO_META
# NEXO_WHATSAPP_TOKEN=TOKEN_OFICIAL_SECRET_NO_SUBIR_A_GIT
# NEXO_WHATSAPP_GRAPH_VERSION=v24.0

# RIA-001: transcripcion local opcional, nunca descarga modelos por defecto.
# NEXO_WHISPER_MODEL=base
# NEXO_WHISPER_ALLOW_DOWNLOAD=0
# NEXO_WHISPER_CACHE=C:\RUTA\CACHE\NEXOAI\whisper
